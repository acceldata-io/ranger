<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>ranger-pinot-plugin</artifactId>
    <name>Pinot Security Plugin</name>
    <description>Apache Pinot service for Ranger Admin, and the Ranger access checker that Pinot's ranger authorization mode calls</description>
    <packaging>jar</packaging>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Pinot's token sources run by Ranger Admin for Test Connection and lookup (pinot-auth directory next to
             the plug-in): Pinot's artifacts of the same release and the dependencies their token sources use -->
        <pinot.version>1.5.1.${odp.release.version}</pinot.version>
        <pinot.auth.accessors-smart.version>2.6.0</pinot.auth.accessors-smart.version>
        <pinot.auth.commons-configuration2.version>2.15.0</pinot.auth.commons-configuration2.version>
        <pinot.auth.commons-lang3.version>3.20.0</pinot.auth.commons-lang3.version>
        <pinot.auth.commons-text.version>1.15.0</pinot.auth.commons-text.version>
        <pinot.auth.json-path.version>2.10.0</pinot.auth.json-path.version>
        <pinot.auth.json-smart.version>2.6.0</pinot.auth.json-smart.version>
        <pinot.auth.log4j.version>2.26.0</pinot.auth.log4j.version>
        <pinot.auth.nimbus-jose-jwt.version>10.8</pinot.auth.nimbus-jose-jwt.version>
        <pinot.auth.slf4j.version>2.0.17</pinot.auth.slf4j.version>
    </properties>
    <parent>
        <groupId>org.apache.ranger</groupId>
        <artifactId>ranger</artifactId>
        <version>2.5.0.3.3.6.6-SNAPSHOT</version>
        <relativePath>..</relativePath>
    </parent>
    <dependencies>
        <dependency>
            <groupId>org.apache.ranger</groupId>
            <artifactId>ranger-plugins-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.ranger</groupId>
            <artifactId>ranger-plugins-audit</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.ranger</groupId>
            <artifactId>credentialbuilder</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- HDFS audit destination (xasecure.audit.destination.hdfs): the plug-in runs in Pinot's JVM, which has no
             HDFS client, so the plug-in brings it, like the Kafka plug-in (plugin-pinot.xml packages these) -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-hdfs</artifactId>
            <version>${hadoop.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-all</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-client-runtime</artifactId>
            <version>${hadoop.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-all</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-hdfs-client</artifactId>
            <version>${hadoop.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-all</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.netty</groupId>
                    <artifactId>netty</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- PinotAccessChecker: the contract shared with Pinot, on Pinot's class path in the shim jar -->
        <dependency>
            <groupId>org.apache.ranger</groupId>
            <artifactId>ranger-pinot-plugin-shim</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <!-- Pinot's token-source jars for Ranger Admin (PinotServiceTokens), outside the plug-in's class path:
                     exactly these, no transitive dependencies -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>pinot-auth</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/pinot-auth</outputDirectory>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.apache.pinot</groupId>
                                    <artifactId>pinot-auth-oauth2</artifactId>
                                    <version>${pinot.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.pinot</groupId>
                                    <artifactId>pinot-auth-spi</artifactId>
                                    <version>${pinot.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.pinot</groupId>
                                    <artifactId>pinot-spi</artifactId>
                                    <version>${pinot.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>net.minidev</groupId>
                                    <artifactId>accessors-smart</artifactId>
                                    <version>${pinot.auth.accessors-smart.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.commons</groupId>
                                    <artifactId>commons-configuration2</artifactId>
                                    <version>${pinot.auth.commons-configuration2.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.commons</groupId>
                                    <artifactId>commons-lang3</artifactId>
                                    <version>${pinot.auth.commons-lang3.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.commons</groupId>
                                    <artifactId>commons-text</artifactId>
                                    <version>${pinot.auth.commons-text.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.jayway.jsonpath</groupId>
                                    <artifactId>json-path</artifactId>
                                    <version>${pinot.auth.json-path.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>net.minidev</groupId>
                                    <artifactId>json-smart</artifactId>
                                    <version>${pinot.auth.json-smart.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.apache.logging.log4j</groupId>
                                    <artifactId>log4j-api</artifactId>
                                    <version>${pinot.auth.log4j.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.nimbusds</groupId>
                                    <artifactId>nimbus-jose-jwt</artifactId>
                                    <version>${pinot.auth.nimbus-jose-jwt.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.slf4j</groupId>
                                    <artifactId>slf4j-api</artifactId>
                                    <version>${pinot.auth.slf4j.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.slf4j</groupId>
                                    <artifactId>jcl-over-slf4j</artifactId>
                                    <version>${pinot.auth.slf4j.version}</version>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
