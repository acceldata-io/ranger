{
  "id":          103,
  "name":        "abfs",
  "displayName": "abfs",
  "implClass":   "org.apache.ranger.services.abfs.RangerServiceABFS",
  "label":       "Azure Blob File System",
  "description": "Ranger plugin for ABFS  (Azure Data Lake Storage Gen2) directory ACL management",
  "guid":        "",
  "options":     { "enableDenyAndExceptionsInPolicies": "true" },
  "resources": [
    {
      "itemId":         1,
      "name":           "storageaccount",
      "parent":         "",
      "level":          10,
      "type":           "string",
      "mandatory":      true,
      "lookupSupported": true,
      "matcher":        "org.apache.ranger.plugin.resourcematcher.RangerDefaultResourceMatcher",
      "matcherOptions": { "wildCard": true, "ignoreCase": false },
      "label":          "Storage Account",
      "description":    "Storage Account for the Path"
    },
    {
      "itemId":         2,
      "name":           "container",
      "parent":         "storageaccount",
      "level":          20,
      "type":           "string",
      "mandatory":      true,
      "lookupSupported": true,
      "matcher":        "org.apache.ranger.plugin.resourcematcher.RangerDefaultResourceMatcher",
      "matcherOptions": { "wildCard": true, "ignoreCase": false },
      "label":          "Storage Account Container",
      "description":    "Storage Account Container for the Path"
    },
    {
      "itemId":            3,
      "name":              "relativepath",
      "parent":            "container",
      "level":              30,
      "type":               "path",
      "mandatory":          true,
      "lookupSupported":    true,
      "recursiveSupported": true,
      "matcher":            "org.apache.ranger.plugin.resourcematcher.RangerPathResourceMatcher",
      "matcherOptions":     { "wildCard": true, "ignoreCase": false },
      "validationRegEx":    "^[/*]$|^\/.*?[^\/]$",
      "validationMessage":  "Relative Path must not end with a slash",
      "label":              "Relative Path",
      "description":        "Relative Path inside Storage Account Container"
    }
  ],
  "accessTypes": [
    { "itemId": 1, "name": "read",  "label": "Read",  "category": "READ" },
    { "itemId": 2, "name": "list",  "label": "List/Traverse",  "category": "READ" },
    { "itemId": 3, "name": "write",  "label": "Write",  "category": "UPDATE" },
    { "itemId": 4, "name": "delete", "label": "Delete", "category": "DELETE" }
  ],
  "configs": [
    { "itemId": 1, "name": "username",                 "type": "string",   "mandatory": false, "label": "Username" },
    { "itemId": 2, "name": "storageAccount",           "type": "string",   "mandatory": true,  "label": "Storage Account Name" },
    { "itemId": 3, "name": "tenantId",                 "type": "string",   "mandatory": true,  "label": "Azure AD Tenant ID" },
    { "itemId": 4, "name": "clientId",                 "type": "string",   "mandatory": true,  "label": "Service Principal Client ID" },
    { "itemId": 5, "name": "clientSecret",             "type": "password", "mandatory": true,  "label": "Service Principal Client Secret" },
    { "itemId": 6, "name": "defaultContainer",         "type": "string",   "mandatory": false, "label": "Default Container (for connection test / lookup)" }
  ],
  "policyConditions": [
    {
      "itemId":      1,
      "name":        "ip-range",
      "evaluator":   "org.apache.ranger.plugin.conditionevaluator.RangerIpMatcher",
      "label":       "IP Address Range",
      "description": "IP Address Range",
      "uiHint" :     "{ \"isMultiValue\":true }"
    }
  ]
}
