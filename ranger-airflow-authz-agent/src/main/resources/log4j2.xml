<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="io.acceldata.airflow.ranger" level="INFO"/>

        <!-- Kept at INFO for release. DEBUG here can surface policy contents
             and request principals. Raise only for short-lived troubleshooting. -->
        <Logger name="org.apache.ranger.admin.client" level="INFO"/>
        <Logger name="org.apache.ranger.plugin.util.PolicyRefresher" level="INFO"/>
        <Logger name="org.apache.ranger" level="INFO"/>
        <Logger name="org.eclipse.jetty" level="WARN"/>

        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
